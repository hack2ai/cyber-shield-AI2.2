{
  "name": "cyber-shield-ai2.2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx tsx server.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build && npx esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:express --external:@google/generative-ai --external:dotenv --external:vite --external:puppeteer",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "test:rules": "vitest run firestore.rules.test.ts",
    "check": "npm run typecheck && npm run test:rules && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.0.1",
    "@google/generative-ai": "^0.11.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.378.0",
    "motion": "^11.2.10",
    "puppeteer": "^25.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.6",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.3.0",
    "tsx": "^4.21.0",
    "whois-json": "^2.0.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/whois-json": "^2.0.4",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.21.4",
    "firebase-tools": "^13.6.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^4.1.7"
  }
}
