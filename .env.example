# Cyber Shield AI server configuration
# Never commit real credentials. Configure these in your local environment or deployment secret manager.

# Server-side provider credentials (NEVER expose these with a VITE_ prefix)
GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
HIBP_API_KEY=
DEHASHED_EMAIL=
DEHASHED_API_KEY=
LYZR_API_KEY=

# Optional runtime configuration
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000

# Frontend-safe API base URL. This is not a secret.
# Leave empty when the frontend and API share the same origin.
VITE_ANALYSIS_API_BASE_URL=
